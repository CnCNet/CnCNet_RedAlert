# Update source and art to network.
update: pre .SYMBOLIC
	-copy i:\cd1\*.* f:\projects\c&c0\cd\win95\cd1 /s /u
	-copy i:\cd2\*.* f:\projects\c&c0\cd\win95\cd2 /s /u
#	-copy i:\cd1\*.* f:\projects\c&c0\cd\dos\cd1 /s /u
