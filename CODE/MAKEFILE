#--------------------------------------------------------------------------
# The IPX assembly object files are created in a special way:
# IPXREAL is the real-mode code that gets stuffed into memory by protected-
# mode code.  It's assembled, then converted into a big header file by
# the 'EBN' utility.
# IPXPROT is the protected-mode code that includes IPXREAL.IBN, and
# provides routines to let C++ read the code's address & size.
#--------------------------------------------------------------------------
$(WWOBJ)\IPXREAL.IBN: $(WWOBJ)\IPXREAL.OBJ
	echo.
	@echo *** ENTERED IBN RULE ***
	echo [IPXREAL.IBN] Creating RSP
	%create $(WWOBJ)\IPXREAL.RSP
	%append $(WWOBJ)\IPXREAL.RSP $(WWOBJ)\IPXREAL.OBJ, $(WWOBJ)\IPXREAL.EXE, $(WWOBJ)\IPXREAL.MAP
#	%append $(WWOBJ)\IPXREAL.RSP $(WWOBJ)\IPXREAL.EXE
#	%append $(WWOBJ)\IPXREAL.RSP $(WWOBJ)\IPXREAL.MAP
    type "$(WWOBJ)\IPXREAL.RSP"
	echo [IPXREAL.IBN] Linking...
	$(%MSDOS) $(TASM)\bin\tlink @"$(WWOBJ)\IPXREAL.RSP"
    @if not exist "$(WWOBJ)\IPXREAL.EXE" (echo ERROR: tlink did not produce IPXREAL.EXE & exit 1)
	echo [IPXREAL.IBN] Stripping...
	$(%MSDOS) $(TASM)\bin\tdstrip "$(WWOBJ)\IPXREAL.EXE"
	echo [IPXREAL.IBN] EBN...
	$(%MSDOS) $(%UTILS)\ebn "$(WWOBJ)\IPXREAL.EXE"
    @if not exist "$(WWOBJ)\IPXREAL.IBN" (echo ERROR: ebn did not produce IPXREAL.IBN & exit 1)

$(WWOBJ)\IPXREAL.OBJ: IPXREAL.ASM
	echo.
	echo Assembling $<
	$(%MSDOS) $(TASM)\bin\tasm /zn /la /ml /m2 "IPXREAL.ASM","$(WWOBJ)\IPXREAL.OBJ"
    @if not exist "$(WWOBJ)\IPXREAL.OBJ" (echo ERROR: tasm did not produce IPXREAL.OBJ & exit 1)

IPXPROT.OBJ: $(WWOBJ)\IPXREAL.IBN IPXPROT.ASM
	echo.
	echo Assembling $<
	$(%MSDOS) $(TASM)\bin\tasm $(ASM_CFG) /I"$(WWOBJ)" "IPXPROT.ASM","$(WWOBJ)\IPXPROT.OBJ"
#	copy $(WWOBJ)\ipxprot.obj d:obj /U


ipx.obj: ipx.cpp function.h
	echo.
	echo Compiling $[.
	*$(CC) $(CC_CFG) -zz -fo$(WWOBJ)\$^. $[*.cpp

ipxmgr.obj: ipxmgr.cpp function.h
	echo.
	echo Compiling $[.
	*$(CC) $(CC_CFG) -zz -fo$(WWOBJ)\$^. $[*.cpp

ipxconn.obj: ipxconn.cpp function.h
	echo.
	echo Compiling $[.
	*$(CC) $(CC_CFG) -zz -fo$(WWOBJ)\$^. $[*.cpp

ipx95.obj: ipx95.cpp function.h
	echo.
	echo Compiling $[.
	*$(CC) $(CC_CFG) -zz -fo$(WWOBJ)\$^. $[*.cpp

winstub.obj: winstub.cpp ipx95.h tcpip.h function.h
	echo.
	echo Compiling $[.
	*$(CC) $(CC_CFG) -zz -fo$(WWOBJ)\$^. $[*.cpp



