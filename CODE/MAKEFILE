#---------------------------------------------------------------------------
# Pull in optional private CnCNet sources.
#
# Only wired in when the build is invoked with CNCNET=1. The source
# location is resolved by MAKE.BAT / MAKE_CNCNET.BAT into the CNCNET_DIR env var
# -- either a separate local clone (.env -> CNCNET_RED_ALERT_PRIVATE_REPO) or the
# in-tree CODE\CNCNET checkout that CI uses. A public clone without either still
# builds (CNCNET is simply not defined).
#
# The fragment appends its object names to OBJECTS, so the private sources
# compile and link with the rest of the game (one link, shared include paths) --
# there is no separate library.
#---------------------------------------------------------------------------
!ifdef CNCNET
CC_CFG += /i=.                    # let CnCNet sources reach game headers (CODE\)
CC_CFG += /i=$(%CNCNET_DIR)       # let game sources reach CNCNET headers (CNCNET.H)
!include $(%CNCNET_DIR)\MAKEFILE
!endif

!ifdef WIN32
PROJ_LIBS = &
	WIN32LIB.LIB

!else
PROJ_LIBS = &
	WWFLAT32.LIB
!endif

VQ_LIBS = &
	VQA32WP.LIB &
	VQM32WP.LIB

GCL_LIBS = &
	GCLFR3S.LIB

MEMCHECK_LIBS = &
	MCA3S.LIB

############################################################################
# Pre-compilation process. Move old files to backup directory.
.BEFORE
#	-if exist *.bak move *.bak bak
#	-if exist $(WWOBJ)\*.pch del $(WWOBJ)\*.pch
	@echo.
	@echo Creating build directories.
	@if not exist "$(WWRUN)" md "$(WWRUN)" 2>nul
	@if not exist "$(WWOBJ)" md "$(WWOBJ)" 2>nul
# Confirm the private CnCNet fragment was pulled in (banner defined there).
!ifdef CNCNET
	@echo.
	@echo $(CNCNET_FRAGMENT_BANNER)
!endif

# After make has completed.
.AFTER

# If there is an abnormal termination in make process (e.g., error in compile).
.ERROR


############################################################################
# Clean target
clean: .SYMBOLIC
	@echo.
	@echo Cleaning up '$^&' files!
    @dir /b /a-d "*.obj" >nul 2>&1 && del "*.obj" || ver >nul
    @dir /b /a-d "*.exe" >nul 2>&1 && del "*.exe" || ver >nul
    @dir /b /a-d "*.lib" >nul 2>&1 && del "*.lib" || ver >nul
    @dir /b /a-d "*.dll" >nul 2>&1 && del "*.dll" || ver >nul
    @dir /b /a-d "*.map" >nul 2>&1 && del "*.map" || ver >nul
    @dir /b /a-d "*.err" >nul 2>&1 && del "*.err" || ver >nul
    @dir /b /a-d "*.lnk" >nul 2>&1 && del "*.lnk" || ver >nul
    @dir /b /a-d "*.pch" >nul 2>&1 && del "*.pch" || ver >nul
    @dir /b /a-d "*.bak" >nul 2>&1 && del "*.bak" || ver >nul
    @dir /b /a-d "$(WWOBJ)\*.obj" >nul 2>&1 && del "$(WWOBJ)\*.obj" || ver >nul
    @dir /b /a-d "$(WWOBJ)\*.exe" >nul 2>&1 && del "$(WWOBJ)\*.exe" || ver >nul
    @dir /b /a-d "$(WWOBJ)\*.lib" >nul 2>&1 && del "$(WWOBJ)\*.lib" || ver >nul
    @dir /b /a-d "$(WWOBJ)\*.dll" >nul 2>&1 && del "$(WWOBJ)\*.dll" || ver >nul
    @dir /b /a-d "$(WWOBJ)\*.map" >nul 2>&1 && del "$(WWOBJ)\*.map" || ver >nul
    @dir /b /a-d "$(WWOBJ)\*.err" >nul 2>&1 && del "$(WWOBJ)\*.err" || ver >nul
    @dir /b /a-d "$(WWOBJ)\*.lnk" >nul 2>&1 && del "$(WWOBJ)\*.lnk" || ver >nul
    @dir /b /a-d "$(WWOBJ)\*.pch" >nul 2>&1 && del "$(WWOBJ)\*.pch" || ver >nul
    @dir /b /a-d "$(WWOBJ)\*.bak" >nul 2>&1 && del "$(WWOBJ)\*.bak" || ver >nul
	@dir /b /a-d "$(WWOBJ)\IPXPROT.OBJ" >nul 2>&1 && del "$(WWOBJ)\IPXPROT.OBJ" || ver >nul
	@dir /b /a-d "$(WWOBJ)\IPXREAL.OBJ" >nul 2>&1 && del "$(WWOBJ)\IPXREAL.OBJ" || ver >nul
	@dir /b /a-d "$(WWOBJ)\IPXREAL.EXE" >nul 2>&1 && del "$(WWOBJ)\IPXREAL.EXE" || ver >nul
	@dir /b /a-d "$(WWOBJ)\IPXREAL.MAP" >nul 2>&1 && del "$(WWOBJ)\IPXREAL.MAP" || ver >nul
	@dir /b /a-d "$(WWOBJ)\IPXREAL.IBN" >nul 2>&1 && del "$(WWOBJ)\IPXREAL.IBN" || ver >nul
    

