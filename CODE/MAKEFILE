OBJ_ROOT=OBJ

!ifdef WIN32
WWOBJ_COMMON=$(OBJ_ROOT)\WIN32
LINKFILE=WIN95.LNK
CC=$(%WATCOM)\binnt\wpp386
LIB=$(%WATCOM)\binnt\wlib
!else
WWOBJ_COMMON=$(OBJ_ROOT)\DOS
LINKFILE=CONQUER.LNK
CC=$(%WATCOM)\binnt\wpp386
LIB=$(%WATCOM)\binnt\wlib
!endif

WWLIB=$(%WWLIB)
TASM=$(%TASM)
WWVQ=$(%WWVQ)
WWOBJ=$(WWOBJ_COMMON)\$(LANGUAGE)

WWRUN=$(%PRJ_ROOT)\RUN\$(LANGUAGE)

# The CnCNet private build is a separate ENGLISH-based pass. Redirect both
# the intermediate object dir and the staged output to a CnCNet-specific folder
# so it does not overwrite the plain ENGLISH build (RUN\ENGLISH\). Output lands
# in RUN\CNCNET\ instead of RUN\<LANGUAGE>\.
!ifdef CNCNET
WWOBJ=$(WWOBJ_COMMON)\CNCNET
WWRUN=$(%PRJ_ROOT)\RUN\CNCNET
!endif


#---------------------------------------------------------------------------
# Path macros: one path for each file type.
#  These paths are used to tell make where to find/put each file type.
#---------------------------------------------------------------------------
.asm:  .
.c:    .

# When building the private CnCNet variant, also search CNCNET_DIR for .cpp
# sources. Path specifiers must live here (Watcom wmake rejects them elsewhere
# with "Ignoring out of place Path Specifier"), and multiple directories must be
# SEMICOLON-separated -- a space would make wmake read CNCNET_DIR's drive-letter
# colon (e.g. X:\...) as a second path specifier and error.
!ifdef CNCNET
.cpp:  .;$(%CNCNET_DIR)
!else
.cpp:  .
!endif

.h:    .
.obj:  $(WWOBJ)
.lib:  $(WWLIB)\LIB
.exe:  $(WWRUN)


#===========================================================================
# Compiler and assembler flags.
#===========================================================================
!ifdef WIN32
CC_CFG = /d0                            # No debugging information	( else use /d1 )
CC_CFG += /DWIN32=1
CC_CFG += /D_WIN32
CC_CFG += /DWOLAPI_INTEGRATION
CC_CFG += /DWINSOCK_IPX
CC_CFG += /D$(LANGUAGE)=1
CC_CFG += /i=$(%DXSDK)\INC
CC_CFG += /i=$(%WATCOM)\H\NT                # NT include directory.
CC_CFG += /i=$(%WATCOM)\H                   # Normal Watcom include directory.
CC_CFG += /i=$(WWLIB)\INCLUDE          # Normal library include directory.
CC_CFG += /i=$(WWVQ)\INCLUDE           # Includes player (VQ) directory.
CC_CFG += /bt=NT
CC_CFG += /otxan
CC_CFG += /5r                           # Pentium optimized register calling conventions.
!else
CC_CFG = /d1                            # Partial debug (line numbers only)
CC_CFG += /i=$(%WATCOM)\H                   # Normal Watcom include directory.
CC_CFG += /i=$(WWLIB)\INCLUDE          # Normal library include directory.
CC_CFG += /i=$(WWVQ)\INCLUDE              # Includes player (VQ) directory.
CC_CFG += /DDOS4G                       # Must be defined for Greenleaf
CC_CFG += /5s                           # Pentium optimized stack calling conventions.
CC_CFG += /DGF_WATCOM_S                 # Must be defined for Greenleaf with /3s
CC_CFG += /bt=DOS
!endif

CC_CFG += /D$(LANGUAGE)=1
CC_CFG += /D$(BUILDVERSION)=1

CC_CFG += /i=$(%GCL510)\H                # Includes Greenleaf headers.
CC_CFG += /of+                          # Generate traceable stack frames.
CC_CFG += /zp1                          # Pack structures on byte boundary.
CC_CFG += /s                            # Remove stack check calls.
CC_CFG += /j                            # char is now signed.
CC_CFG += /fh=$(WWOBJ)\CONQUER.PCH      # Use precompiled headers.
CC_CFG += /fhq
CC_CFG += /we                           # Treat all warnings as errors.
CC_CFG += /w8                           # Most warnings enabled.
CC_CFG += /ri                           # char and shorts are returned as int.
CC_CFG += /zq                           # Operate quietly.

ASM_CFG = /i$(WWLIB)\INCLUDE           # Include directory.
ASM_CFG += /zd                          # Debugging information line numbers.
ASM_CFG += /t                           # Quiet operation.
ASM_CFG += /m                           # Allow multiple passes.
ASM_CFG += /w+                          # Enable maximum warnings.
ASM_CFG += /jJUMPS                      # Enable jump optimizations.
ASM_CFG += /ml                          # Case sensitivity on code.


#---------------------------------------------------------------------------
# Implicit rules
# Compiler:
# 	($< = full dependent with path)
# Assembler:
# 	output obj's are constructed from .obj: & the $& macro
# 	($< = full dependent with path)
# 	tasm's cfg file is not invoked as a response file.
#---------------------------------------------------------------------------

.c.obj: .AUTODEPEND
	echo.
	echo Compiling $<
	*$(CC) $(CC_CFG) -fo$(WWOBJ)\$^. $<

.cpp.obj: .AUTODEPEND
	echo.
	echo Compiling $<
	*$(CC) $(CC_CFG) -fo$(WWOBJ)\$^. $<

.asm.obj:
	echo.
	echo Assembling $<
	$(%MSDOS) tasm $(ASM_CFG) $<, $(WWOBJ)\$^.

