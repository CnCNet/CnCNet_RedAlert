## Ignore Watcom compiler temporary files, build results, and generated files.

# Files generated by the compiler
*.obj
*.lib
*.lnk
*.bak
*.rsp
*.map
*.ibn
*.lst
*.pch
*.err
*.res

# Files generated by the makefiles
*.lbc

# Ignore any compiled binaries
*.exe
*.dll

# Hide all OBJ folder
OBJ/

# Required dependencies and tools
WATCOM*/
LINKER/
TASM/
MASM/
UTILS/

# Required SDKs and libraries
DXSDK/
DXMEDIA/
GCL510/
DBWIN32/

# Required SDKs and libraries
MPGDLL/
UUIDLIB/

# Final build results
RUN/

# Private CnCNet sources:
# - CI checks them out into CODE/CNCNET.
# - local devs point .env at a separate clone.
CODE/CNCNET/
.env
